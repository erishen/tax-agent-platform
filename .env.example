# LLM — Agnes (default provider, OpenAI-compatible)
TAX_AGNES_KEY=your-agnes-key
TAX_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
TAX_AGNES_MODEL=agnes-2.0-flash

# LLM — DeepSeek (alternate provider)
# TAX_OPENAI_API_KEY=your-deepseek-api-key
# TAX_OPENAI_BASE_URL=https://api.deepseek.com/v1
# TAX_OPENAI_MODEL=deepseek-chat

# Default LLM provider: "agnes" | "deepseek"
TAX_LLM_PROVIDER=agnes

# Agent
TAX_MAX_RETRIES=3
TAX_CIRCUIT_BREAKER_THRESHOLD=5
TAX_LLM_TIMEOUT=30.0

# RAG
TAX_RAG_TOP_K=20
TAX_RAG_RERANK_K=5
TAX_CHUNK_SIZE=512
TAX_CHUNK_OVERLAP=64
# Recall mode: "hybrid" (vector + lexical blend, recommended for Chinese) | "vector" (dense only)
TAX_RAG_MODE=hybrid
# Local embedding (Ollama). `ollama pull nomic-embed-text`; swap to snowflake-arctic-embed2 for higher recall
TAX_EMBEDDING_MODEL=nomic-embed-text
TAX_EMBEDDING_URL=http://localhost:11434/api/embed
TAX_EMBEDDING_TIMEOUT=10.0

# Token pricing (CNY / 1K tokens) — used by /agent/run & /agent/stream token_usage
TAX_AGNES_PRICE_PROMPT=0.004
TAX_AGNES_PRICE_COMPLETION=0.012
TAX_DEEPSEEK_PRICE_PROMPT=0.001
TAX_DEEPSEEK_PRICE_COMPLETION=0.002

# Server
TAX_HOST=0.0.0.0
TAX_PORT=8001

# Auth (gateway-level tenant API keys) — tenant identity is DERIVED from the key.
# In production, issue per-tenant keys out-of-band and NEVER ship them in a SPA.
# Set TAX_AUTH_REQUIRED=false to fall back to the legacy client-claimed X-Tenant-ID
# (dev only — disables tenant-spoofing protection).
TAX_AUTH_REQUIRED=true
TAX_TENANT_API_KEYS={"acme-cn":"tax_demo_acme_cn_8f3a","acme-us":"tax_demo_acme_us_2b9e","demo":"tax_demo_demo_5c71"}
