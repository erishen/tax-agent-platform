# Frontend build-time config (Vite). Copy to `.env.local` and fill in.
# The API key is embedded in the built JS, so ONLY use per-user/dev keys here —
# never a shared production secret. In production, issue keys server-side.

# Per-user API key (falls back to a non-secret dev demo key when unset).
VITE_TAX_API_KEY=tax_demo_acme_cn_8f3a

# Optional default tenant id.
VITE_TAX_TENANT=acme-cn
